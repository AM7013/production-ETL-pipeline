# ==================== Database Configuration ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=etl_pipeline
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ==================== BigQuery Configuration ====================
GOOGLE_CLOUD_PROJECT=your-project-id
BIGQUERY_DATASET=your_dataset_name
# Path to service account key (if using key file)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account-key.json

# ==================== Prefect Configuration ====================
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/your-account-id/workspaces/your-workspace-id
PREFECT_API_KEY=your_prefect_api_key_here

# ==================== Spark / Application Settings ====================
ENVIRONMENT=development
LOG_LEVEL=INFO
TARGET_DATE=2026-07-01

# ==================== Data Paths ====================
INPUT_DATA_PATH=./Sample/cleaned_data_v1.csv
QUARANTINE_PATH=./quarantine_zone.csv
