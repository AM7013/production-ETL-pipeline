# ==================== Database Configuration ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=etl_pipeline
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ==================== BigQuery Configuration ====================
GOOGLE_CLOUD_PROJECT=your-project-id
BIGQUERY_DATASET=your_dataset_name

# Path to service account key (recommended for local development)
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account-key.json

# ==================== Prefect Configuration ====================
PREFECT_API_URL=https://api.prefect.cloud/api/accounts/YOUR_ACCOUNT_ID/workspaces/YOUR_WORKSPACE_ID
PREFECT_API_KEY=prefect_api_key_here

# ==================== Application Settings ====================
ENVIRONMENT=development          # development / staging / production
LOG_LEVEL=INFO
TARGET_DATE=2027-01-01

# ==================== Data Paths ====================
INPUT_DATA_PATH=./samples/cleaned_data_test.csv
QUARANTINE_PATH=./quarantine_zone.csv

# ==================== Spark Configuration ====================
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
